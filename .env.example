# Docker / Compose
MONGO_IMAGE=mongo:8
MONGO_CONTAINER_NAME=certvault-mongo
BACKEND_CONTAINER_NAME=certvault-backend
FRONTEND_CONTAINER_NAME=certvault-frontend
MONGO_PORT=27018
BACKEND_PORT=3000
FRONTEND_PORT=8080
BACKEND_UPSTREAM_HOST=backend

# Backend runtime
NODE_ENV=production
APP_HOST=localhost
PORT=${BACKEND_PORT}
FRONTEND_URL=http://${APP_HOST}:${FRONTEND_PORT},https://certvault.netics.corp
PUBLIC_API_BASE_URL=http://${APP_HOST}:${FRONTEND_PORT}
ALLOWED_ORIGINS=http://${APP_HOST}:${FRONTEND_PORT},https://certvault.netics.corp
CORS_ALLOW_ALL_ORIGINS=false
APP_NAME=CertiVault
MONGODB_URI=mongodb://mongo:27017/certif-app
JWT_SECRET=change-this-with-a-long-random-string
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin123!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=CertiVault
SMTP_ENCRYPTION_KEY=
RESET_PASSWORD_EXPIRE_MINUTES=10
VERIFY_EMAIL_EXPIRE_MINUTES=60
MAX_CERTIFICATE_FILE_SIZE=5242880
