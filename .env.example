# Docker / Compose
MONGO_IMAGE=mongo:8
MONGO_CONTAINER_NAME=certvault-mongo
BACKEND_CONTAINER_NAME=certvault-backend
FRONTEND_CONTAINER_NAME=certvault-frontend
MONGO_PORT=27017
BACKEND_PORT=3000
FRONTEND_PORT=443
BACKEND_UPSTREAM_HOST=backend

# Backend runtime
NODE_ENV=production
# Host de la aplicacion (Cambiar por la IP del servidor o DNS corporativo en produccion, ej: 172.20.15.16 o certvault.netics.corp)
APP_HOST=localhost
SEED_DATABASE=false
PORT=${BACKEND_PORT}
# URLs y dominios de acceso para el Frontend y CORS (ahora bajo HTTPS producción)
FRONTEND_URL=https://${APP_HOST},https://certvault.netics.corp
PUBLIC_API_BASE_URL=https://${APP_HOST}
ALLOWED_ORIGINS=https://${APP_HOST},https://certvault.netics.corp
CORS_ALLOW_ALL_ORIGINS=false
APP_NAME=CertiVault
MONGODB_URI=mongodb://mongo:27017/certif-app
JWT_SECRET=change-this-with-a-long-random-string
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin123!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=CertiVault
SMTP_ENCRYPTION_KEY=
# Vigencia del enlace de restablecimiento. Una ventana corta puede expirar antes de que
# el correo llegue a la bandeja del destinatario (ver ISS-025 en issues.md).
RESET_PASSWORD_EXPIRE_MINUTES=60
VERIFY_EMAIL_EXPIRE_MINUTES=60

# Limite global de trafico. Es amplio a proposito porque debe dar cabida a la navegacion
# normal del SPA, asi que no protege por si solo a los endpoints sensibles.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Presupuesto propio de la recuperacion de contrasena, mucho mas estricto que el global.
# Se limita en dos dimensiones: por IP frena el abuso desde un mismo origen, y por cuenta
# frena la inundacion del buzon de una victima cuando el atacante rota direcciones IP.
# Todos estos valores deben ser enteros positivos; el servidor no arranca si alguno es invalido.
PASSWORD_RECOVERY_WINDOW_MS=900000
PASSWORD_RECOVERY_MAX_PER_IP=5
PASSWORD_RECOVERY_ACCOUNT_WINDOW_MS=3600000
PASSWORD_RECOVERY_MAX_PER_ACCOUNT=3
# Intentos fallidos de usar o verificar un enlace. Los aciertos no consumen presupuesto.
PASSWORD_RECOVERY_MAX_TOKEN_ATTEMPTS=10
# Tamano maximo por archivo. Los certificados admiten PDF, JPEG y PNG; los avatares
# admiten ademas WEBP y GIF. SVG esta excluido de forma deliberada (ver ISS-028/ISS-034).
MAX_CERTIFICATE_FILE_SIZE=5242880
MAX_AVATAR_FILE_SIZE=2097152

# Solo desarrollo: acepta el login LDAP sin contactar al Directorio Activo cuando el
# servidor no esta disponible. Nunca se activa con NODE_ENV=production. Dejar en false.
LDAP_SIMULATION_ENABLED=false
