{
  "name": "certif-app-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de gestión de certificaciones empresariales",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts,json --ignore dist --ignore uploads --exec ts-node src/server.ts",
    "dev-demo": "nodemon --watch src --ext ts,json --ignore dist --ignore uploads --exec ts-node src/server-demo.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "migrate:server-policy": "ts-node src/scripts/migrateServerPolicyFromSmtpProfiles.ts"
  },
  "keywords": [
    "certification",
    "management",
    "enterprise",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Sistema de Certificaciones",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/validator": "^13.15.3",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^8.5.1",
    "ldapjs": "^3.0.7",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "validator": "^13.15.20",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^30.0.0",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.5",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
