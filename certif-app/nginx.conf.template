# Determinar de forma robusta el protocolo de conexión original (HTTP o HTTPS)
# Si el proxy inverso intermedio envió el encabezado X-Forwarded-Proto, lo propagamos intacto.
# Si no viene definido, usamos el esquema de conexión directa al contenedor ($scheme).
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    root /usr/share/nginx/html;
    index index.html;

    # Sirve la aplicación de Angular manejando el ruteo del lado del cliente
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Redirección de llamadas API hacia el contenedor del Backend
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM_HOST}:${BACKEND_UPSTREAM_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Uso del valor mapeado para garantizar que Express reconozca la conexión HTTPS
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    }

    # Redirección de peticiones de archivos subidos hacia el backend
    location /uploads/ {
        proxy_pass http://${BACKEND_UPSTREAM_HOST}:${BACKEND_UPSTREAM_PORT}/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Uso del valor mapeado para garantizar la persistencia del protocolo HTTPS original
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    }
}
