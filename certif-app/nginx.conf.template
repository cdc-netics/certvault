# Determinar de forma robusta el protocolo de conexión original (HTTP o HTTPS)
# Si el proxy inverso intermedio envió el encabezado X-Forwarded-Proto, lo propagamos intacto.
# Si no viene definido, usamos el esquema de conexión directa al contenedor ($scheme).
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    root /usr/share/nginx/html;
    index index.html;

    # El index.html referencia los bundles por su nombre hasheado, por lo que debe
    # revalidarse siempre: si el navegador lo sirve desde caché, sigue cargando el
    # bundle del despliegue anterior y el usuario nunca recibe la versión nueva.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Los artefactos de build de Angular llevan hash de contenido en el nombre, así que
    # una URL dada nunca cambia de contenido y puede cachearse indefinidamente.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # Sirve la aplicación de Angular manejando el ruteo del lado del cliente
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Redirección de llamadas API hacia el contenedor del Backend.
    # El prefijo ^~ es obligatorio: sin él, la ubicación regex de assets estáticos
    # tendría prioridad y las peticiones a archivos con esas extensiones se buscarían
    # en el disco del frontend en lugar de proxearse al backend.
    location ^~ /api/ {
        proxy_pass http://${BACKEND_UPSTREAM_HOST}:${BACKEND_UPSTREAM_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Uso del valor mapeado para garantizar que Express reconozca la conexión HTTPS
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    }

    # Redirección de peticiones de archivos subidos hacia el backend.
    # Requiere ^~ por el mismo motivo que /api/: los avatares y certificados tienen
    # extensiones de imagen que colisionan con la ubicación regex de assets estáticos.
    location ^~ /uploads/ {
        proxy_pass http://${BACKEND_UPSTREAM_HOST}:${BACKEND_UPSTREAM_PORT}/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Uso del valor mapeado para garantizar la persistencia del protocolo HTTPS original
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    }
}
